# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com/dashboard, then go to
# Project Settings -> API. The dashboard has renamed these over time, so
# grab whichever labels you see:
#   Project URL                          -> NEXT_PUBLIC_SUPABASE_URL
#   "anon public" / "publishable" key    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   "service_role" / "secret" key        -> SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never send to the
# browser. Used only for account deletion (lib/actions/profile.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---------------------------------------------------------------------------
# Google Places (nearby date ideas) — optional but recommended
# ---------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services -> Library -> enable "Places API (New)".
# 3. APIs & Services -> Credentials -> Create credentials -> API key.
# 4. Restrict the key: Application restrictions -> "IP addresses" (server-
#    side use only, since this key is never sent to the browser), and
#    API restrictions -> limit to "Places API (New)".
# 5. Set a billing account — Google requires one, but Places API (New) has
#    a monthly free tier that comfortably covers hobby-project traffic.
# Without this key, Discover still works fully using the at-home and
# generic "find a ___ nearby" seed activities — it just won't show real,
# named places pulled from Google Places.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# App URL — used to build email confirmation / OAuth redirect links.
# ---------------------------------------------------------------------------
# Leave unset in most cases; the app derives it from the request host. Set
# this explicitly only if you're behind a proxy that mangles those headers,
# or want to force a specific canonical domain.
# NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.com
